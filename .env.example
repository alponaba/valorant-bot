DISCORD_TOKEN=your_discord_bot_token
HENRIK_API_KEY=your_henrik_api_key_optional
BOT_PREFIX=v!
PORT=8080
AUTO_SYNC_COMMANDS=true
DATABASE_PATH=data/vtracker.sqlite3

# Optional channel / role settings
VERIFICATION_CHANNEL_ID=
SUGGESTION_CHANNEL_ID=
VERIFIER_ROLE_ID=
ADMIN_LOG_CHANNEL_ID=

# Optional security tuning
TRUSTED_IMAGE_HOSTS=cdn.discordapp.com,media.discordapp.net,images-ext-1.discordapp.net,tracker.gg,media.valorant-api.com,imgur.com,i.imgur.com
GLOBAL_USER_RATE=6
GLOBAL_USER_WINDOW=10
GLOBAL_GUILD_RATE=40
GLOBAL_GUILD_WINDOW=10
API_FAIL_OPEN_COUNT=5
API_COOLDOWN_SECONDS=30
